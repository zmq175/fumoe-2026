{
  "name": "fumoe-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler dev --local --port 8787",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:season": "npm run build && node scripts/simulate-season.mjs",
    "verify": "npm run check && npm test && npm run test:e2e && npm run test:season",
    "preflight": "node --env-file-if-exists=.env.production scripts/preflight.ts",
    "deploy:check": "npm run preflight && npm run verify && npm run build && wrangler deploy --dry-run",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "preview:midstate:prepare": "node scripts/prepare-midstate-preview.mjs",
    "preview:midstate": "VITE_DEV_AUTH_BYPASS=true VITE_TURNSTILE_SITE_KEY= npm run build && wrangler dev --local --persist-to /tmp/fumoe-midstate-preview --port 8788 --var APP_ORIGIN:http://127.0.0.1:8788 --var DEV_AUTH_BYPASS:true --var ADMIN_EMAILS:admin@fumoe.local --var AUTH_SECRET:midstate-preview-secret-at-least-32-characters",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fumoe-2026 --local",
    "db:migrate:remote": "wrangler d1 migrations apply fumoe-2026 --remote",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local && npm run seed:local",
    "seed:local": "node scripts/seed-local.mjs && npm run artwork:backfill:local",
    "artwork:backfill:local": "node scripts/backfill-local-artwork.mjs",
    "artwork:discover": "node scripts/discover-official-artwork.mjs",
    "artwork:sync": "node scripts/sync-official-artwork.mjs",
    "artwork:community-discover": "node scripts/discover-community-artwork.mjs",
    "artwork:missing-discover": "node scripts/discover-missing-artwork.mjs",
    "artwork:missing-review": "node scripts/build-artwork-contact-sheet.mjs",
    "artwork:missing-archive": "node scripts/archive-reviewed-artwork.mjs",
    "artwork:community-api": "node scripts/discover-community-artwork-api.mjs",
    "artwork:community-batched": "node scripts/discover-community-artwork-batched.mjs",
    "artwork:community-select": "node scripts/select-community-portraits.mjs",
    "artwork:community-archive": "node scripts/archive-community-artwork.mjs",
    "artwork:process": "node scripts/process-artwork.mjs",
    "artwork:preview": "node scripts/prepare-local-artwork-preview.mjs",
    "artwork:validate": "node scripts/validate-artwork.mjs",
    "artwork:upload-plan": "node scripts/upload-artwork.mjs",
    "artwork:one-time-import": "npm run artwork:discover && npm run artwork:sync && npm run artwork:community-discover && npm run artwork:community-archive && npm run artwork:process && npm run artwork:upload-plan"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@hono/zod-validator": "^0.7.3",
    "hono": "^4.11.10",
    "jose": "^6.1.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^6.2.3",
    "sharp": "^0.34.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
