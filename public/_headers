/image-variants/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML entry points must revalidate; hashed assets above remain immutable.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/matches
  Cache-Control: no-cache, max-age=0, must-revalidate
/bracket
  Cache-Control: no-cache, max-age=0, must-revalidate
/factions
  Cache-Control: no-cache, max-age=0, must-revalidate
/gallery
  Cache-Control: no-cache, max-age=0, must-revalidate
/seasons
  Cache-Control: no-cache, max-age=0, must-revalidate
/seasons/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/admin
  Cache-Control: no-cache, max-age=0, must-revalidate
/admin/*
  Cache-Control: no-cache, max-age=0, must-revalidate
